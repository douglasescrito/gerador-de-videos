{
  "name": "gerador-de-videos-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mktvideo": "scripts/omni-cli.mjs"
  },
  "scripts": {
    "v18": "node lib/media-pipeline/v18-orchestrator.mjs",
    "video": "node scripts/omni-cli.mjs",
    "series": "node scripts/educational-series-cli.mjs",
    "captions": "node scripts/render-word-captions.mjs",
    "chain": "node scripts/encadear-planos.mjs",
    "image": "node scripts/omni-cli.mjs image",
    "studio": "node scripts/ai-studio-headless.mjs",
    "session": "node scripts/persistent-session.mjs",
    "studio:test": "node scripts/omni-product-studio-submit.mjs",
    "doctor": "node scripts/omni-cli.mjs doctor",
    "prompt:mine": "node scripts/grok-prompt-miner-cli.mjs",
    "prompt:bank": "node scripts/prompt-bank-builder.mjs",
    "prompt:query": "node scripts/prompt-bank-query.mjs",
    "organize:outputs": "node scripts/organize-outputs.mjs",
    "governance:baseline": "node scripts/governance-baseline.mjs",
    "executor:replay:corpus": "node scripts/generate-executor-replay-corpus.mjs",
    "renderer:bakeoff": "node scripts/run-renderer-bakeoff.mjs",
    "benchmark:phase7": "node scripts/benchmark-phase7-compute.mjs",
    "prepare:live-gates": "node scripts/prepare-live-roadmap-gates.mjs",
    "inventory:schema-bearing": "node scripts/inventory-schema-bearing.mjs",
    "pilot:feedback-learning": "node scripts/run-feedback-learning-pilot.mjs",
    "governance:references": "node scripts/reference-governance.mjs",
    "governance:reference-study": "node scripts/generate-reference-motion-study.mjs",
    "governance:docs": "node scripts/generate-governance-docs.mjs",
    "governance:docs:check": "node scripts/generate-governance-docs.mjs --check",
    "catalog:styles": "node scripts/generate-style-catalog.mjs",
    "catalog:styles:check": "node scripts/generate-style-catalog.mjs --check",
    "catalog:techniques": "node scripts/generate-technique-catalog.mjs",
    "catalog:techniques:check": "node scripts/generate-technique-catalog.mjs --check",
    "catalog:knowledge-packs": "node scripts/generate-knowledge-pack-catalog.mjs",
    "catalog:knowledge-packs:check": "node scripts/generate-knowledge-pack-catalog.mjs --check",
    "catalog:ontology": "node scripts/generate-audiovisual-ontology.mjs",
    "catalog:ontology:check": "node scripts/generate-audiovisual-ontology.mjs --check",
    "recipe:contracts": "node scripts/generate-recipe-contracts.mjs",
    "recipe:contracts:check": "node scripts/generate-recipe-contracts.mjs --check",
    "docs:agent-contract": "node scripts/generate-agent-contract.mjs",
    "docs:agent-contract:check": "node scripts/generate-agent-contract.mjs --check",
    "docs:check": "npm run governance:docs:check && npm run catalog:styles:check && npm run catalog:techniques:check && npm run catalog:knowledge-packs:check && npm run catalog:ontology:check && npm run recipe:contracts:check && npm run docs:agent-contract:check",
    "recipes:check": "node scripts/omni-cli.mjs receitas --action validar",
    "test:core": "node --import ./test/test-environment.mjs --test --test-concurrency=2 test/*.test.mjs",
    "test:determinism": "node scripts/run-determinism-gate.mjs --runs 20",
    "test": "npm run test:core",
    "test:coverage:core": "node --import ./test/test-environment.mjs --experimental-test-coverage --test --test-concurrency=2 test/*.test.mjs",
    "test:coverage": "npm run test:coverage:core",
    "exports:check": "node scripts/check-orphan-exports.mjs",
    "exports:baseline": "node scripts/check-orphan-exports.mjs --write",
    "check": "node scripts/run-verification.mjs --mode full",
    "check:fast": "node scripts/run-verification.mjs --mode fast",
    "check:affected": "node scripts/run-verification.mjs --mode affected",
    "check:stress": "node scripts/run-verification.mjs --mode stress",
    "acervo": "node app/editor/server.mjs",
    "acervo:completar": "node scripts/acervo-completar.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "playwright-core": "^1.61.1"
  },
  "dependencies": {
    "@hyperframes/engine": "0.8.30",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@remotion/bundler": "4.0.521",
    "@remotion/renderer": "4.0.521",
    "@theatre/core": "0.7.2",
    "@theatre/studio": "0.7.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "gsap": "3.14.2",
    "opentype.js": "2.0.0",
    "postprocessing": "6.39.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.521",
    "three": "0.185.0",
    "three.quarks": "0.17.1"
  }
}
