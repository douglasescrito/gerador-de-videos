{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gerador-de-videos/receita@2/vertical-2.5D",
  "title": "Receita Mestre 2.5D - filme lote e longa duracao",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "vertical",
    "mode",
    "kind",
    "identity",
    "scope",
    "format",
    "program",
    "assets",
    "cast",
    "videoGeneration",
    "narration",
    "alignment",
    "music",
    "sfx",
    "captions",
    "mix",
    "assembly",
    "transitions",
    "graphics",
    "postProduction",
    "qa",
    "delivery",
    "variants",
    "executionPolicy",
    "batch"
  ],
  "properties": {
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "enum": [
            "off",
            "prefer-approved",
            "require-approved"
          ]
        }
      }
    },
    "schema": {
      "const": "gerador-de-videos/receita@2"
    },
    "vertical": {
      "const": "2.5D"
    },
    "mode": {
      "const": "studio"
    },
    "kind": {
      "enum": [
        "peca",
        "filme",
        "lote"
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanReview"
      ],
      "properties": {
        "humanReview": {
          "type": "boolean"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief"
      ],
      "properties": {
        "brief": {
          "type": "object",
          "description": "studio-brief@1 selado, revalidado pelo compilador."
        },
        "creativeDirection": {
          "type": "object",
          "description": "Decisão humana creative-direction-decision@1 selada, no mesmo root e projeto."
        },
        "styleComposition": {
          "type": "object",
          "description": "Composição de direção recipe-style-composition@1 congelada com hashes dos prompts, brief e escopo; sem autoridade de execução."
        },
        "knowledgeContextBinding": {
          "type": "object",
          "description": "Binding mínimo knowledge-context-binding@1, sem conteúdo privado; o snapshot materializado é fornecido separadamente ao compilador."
        }
      }
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "format": {
      "$ref": "#/$defs/format"
    },
    "program": {
      "$ref": "#/$defs/program"
    },
    "assets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "cast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "people"
      ],
      "properties": {
        "people": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "assetId",
              "role"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "assetId": {
                "$ref": "#/$defs/id"
              },
              "role": {
                "enum": [
                  "person-reference",
                  "character-reference"
                ]
              }
            }
          }
        }
      }
    },
    "videoGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "shots"
      ],
      "properties": {
        "module": {
          "const": "omni-video@1"
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shotId",
              "task",
              "prompt",
              "inputAssetIds"
            ],
            "properties": {
              "shotId": {
                "$ref": "#/$defs/id"
              },
              "task": {
                "enum": [
                  "text-to-video",
                  "image-to-video",
                  "reference-to-video",
                  "edit-video",
                  "end-frame"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "inputAssetIds": {
                "type": "array",
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "castIds": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    "narration": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "module",
        "speakerMode",
        "voice",
        "documentUrl",
        "blocks",
        "timing"
      ],
      "properties": {
        "module": {
          "const": "google-vids-narration@1"
        },
        "speakerMode": {
          "enum": [
            "one-voice",
            "multi-voice"
          ]
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "speakers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "voice"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "voice": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "documentUrl": {
          "type": "string",
          "pattern": "^https://docs\\.google\\.com/videos/d/"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "speakerId"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "speakerId": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "timing": {
          "$ref": "#/$defs/plannedTiming"
        }
      }
    },
    "alignment": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "module",
        "backend",
        "language",
        "timing"
      ],
      "properties": {
        "module": {
          "const": "whisper-alignment@1"
        },
        "backend": {
          "enum": [
            "openai-whisper",
            "faster-whisper",
            "whisper-cpp"
          ]
        },
        "language": {
          "const": "pt"
        },
        "timing": {
          "$ref": "#/$defs/plannedTiming"
        }
      }
    },
    "music": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "module",
        "intent",
        "fit",
        "timing"
      ],
      "properties": {
        "module": {
          "const": "flow-music@1"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "fit": {
          "const": "clean-cut"
        },
        "timing": {
          "$ref": "#/$defs/plannedTiming"
        }
      }
    },
    "sfx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "cues"
      ],
      "properties": {
        "module": {
          "const": "local-sfx@1"
        },
        "cues": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "assetId",
              "atFrame",
              "gainDb"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "assetId": {
                "$ref": "#/$defs/id"
              },
              "atFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000
              },
              "gainDb": {
                "type": "number",
                "minimum": -96,
                "maximum": 12
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "module",
        "mode",
        "source",
        "timing"
      ],
      "properties": {
        "module": {
          "const": "word-captions@1"
        },
        "mode": {
          "enum": [
            "none",
            "word"
          ]
        },
        "source": {
          "const": "whisper"
        },
        "timing": {
          "$ref": "#/$defs/plannedTiming"
        }
      }
    },
    "mix": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "module",
        "voiceGainDb",
        "musicGainDb",
        "sfxGainDb",
        "ending"
      ],
      "properties": {
        "module": {
          "const": "ffmpeg-mix@1"
        },
        "voiceGainDb": {
          "type": "number",
          "minimum": -96,
          "maximum": 12
        },
        "musicGainDb": {
          "type": "number",
          "minimum": -96,
          "maximum": 12
        },
        "sfxGainDb": {
          "type": "number",
          "minimum": -96,
          "maximum": 12
        },
        "sceneAudioGainDb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -96,
          "maximum": 12
        },
        "ending": {
          "const": "clean-cut"
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "mode",
        "transition"
      ],
      "properties": {
        "module": {
          "const": "ffmpeg-assembly@1"
        },
        "mode": {
          "const": "concat"
        },
        "transition": {
          "const": "cut@1"
        }
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "edges"
      ],
      "properties": {
        "module": {
          "const": "ffmpeg-transitions@1"
        },
        "edges": {
          "type": "array",
          "maxItems": 999,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromShotId",
              "toShotId",
              "transition",
              "durationFrames"
            ],
            "properties": {
              "fromShotId": {
                "$ref": "#/$defs/id"
              },
              "toShotId": {
                "$ref": "#/$defs/id"
              },
              "transition": {
                "enum": [
                  "cut@1",
                  "fade@1",
                  "dissolve@1",
                  "wipe-left@1",
                  "wipe-right@1",
                  "slide-left@1",
                  "slide-right@1"
                ]
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 864000
              }
            }
          }
        }
      }
    },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "scenes"
      ],
      "properties": {
        "module": {
          "const": "scene-graphics@1"
        },
        "scenes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shotId",
              "renderer",
              "text",
              "documentAssetId"
            ],
            "properties": {
              "shotId": {
                "$ref": "#/$defs/id"
              },
              "renderer": {
                "enum": [
                  "none@1",
                  "local-gc@1",
                  "html-canvas@1"
                ]
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4000
              },
              "documentAssetId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "postProduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "operations"
      ],
      "properties": {
        "module": {
          "const": "ffmpeg-post@1"
        },
        "operations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operation",
              "assetId",
              "durationFrames"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "operation": {
                "enum": [
                  "color-normalize@1",
                  "logo-overlay@1",
                  "ending-hold@1"
                ]
              },
              "assetId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "durationFrames": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 864000
              }
            }
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "policy",
        "technical",
        "semantic",
        "assertions"
      ],
      "properties": {
        "module": {
          "const": "master-qa@1"
        },
        "policy": {
          "const": "strict@1"
        },
        "technical": {
          "const": true
        },
        "semantic": {
          "type": "boolean"
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "video-stream",
              "audio-stream",
              "duration",
              "caption-binding",
              "no-unplanned-frame",
              "clean-cut"
            ]
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "target",
        "overwrite",
        "externalDecision"
      ],
      "properties": {
        "module": {
          "const": "delivery@1"
        },
        "target": {
          "enum": [
            "local-output@1",
            "drive-daily@1"
          ]
        },
        "overwrite": {
          "const": false
        },
        "externalDecision": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "confirmation",
            "bindingHash"
          ],
          "properties": {
            "confirmation": {
              "const": "confirm-drive-write"
            },
            "bindingHash": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "items"
      ],
      "properties": {
        "module": {
          "const": "format-variants@1"
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "strategy",
              "approved"
            ],
            "properties": {
              "format": {
                "enum": [
                  "16:9",
                  "9:16",
                  "1:1"
                ]
              },
              "strategy": {
                "enum": [
                  "fit-pad",
                  "center-crop"
                ]
              },
              "approved": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "segmentation",
        "maxClipFrames",
        "failurePolicy",
        "partialSuccess",
        "maxChildren"
      ],
      "properties": {
        "module": {
          "const": "segmented-execution@1"
        },
        "segmentation": {
          "const": "explicit-shots"
        },
        "maxClipFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 864000
        },
        "failurePolicy": {
          "enum": [
            "fail-fast",
            "continue"
          ]
        },
        "partialSuccess": {
          "enum": [
            "deny",
            "allow"
          ]
        },
        "maxChildren": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "batch": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "module",
        "rows"
      ],
      "properties": {
        "module": {
          "const": "explicit-batch@1"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "promptOverrides"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "promptOverrides": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "shotId",
                    "prompt"
                  ],
                  "properties": {
                    "shotId": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12000
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plannedTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "planned-not-measured"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "request": {
          "description": "Texto literal do pedido humano que originou esta receita. Opcional por compatibilidade; é a evidência de intenção da Fase 9 e não influencia compilação.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootScopeId",
        "projectScopeId"
      ],
      "properties": {
        "rootScopeId": {
          "type": "string",
          "pattern": "^client:[a-z0-9][a-z0-9:_-]*$"
        },
        "projectScopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master"
      ],
      "properties": {
        "master": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "fps"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 16,
              "maximum": 8192
            },
            "height": {
              "type": "integer",
              "minimum": 16,
              "maximum": 8192
            },
            "fps": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "numerator",
                "denominator"
              ],
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120000
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1001
                }
              }
            }
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationPolicy",
        "durationFrames",
        "shots"
      ],
      "properties": {
        "durationPolicy": {
          "const": "fixed-frames"
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640000
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "durationFrames"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 864000
              }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mediaKind",
        "role",
        "source",
        "bytes",
        "sha256",
        "mimeType",
        "rights",
        "authorization"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "mediaKind": {
          "enum": [
            "image",
            "video",
            "audio",
            "document"
          ]
        },
        "role": {
          "enum": [
            "first-frame",
            "reference-image",
            "reference-video",
            "person-reference",
            "sfx",
            "graphics-document",
            "logo"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locator"
          ],
          "properties": {
            "kind": {
              "enum": [
                "knowledge-core",
                "workspace"
              ]
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mimeType": {
          "type": "string",
          "pattern": "^(image|video|audio|text)/"
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providerInput",
            "reuse"
          ],
          "properties": {
            "providerInput": {
              "enum": [
                "allowed",
                "denied",
                "unknown"
              ]
            },
            "reuse": {
              "enum": [
                "allowed",
                "denied",
                "unknown"
              ]
            }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "bindingHash"
          ],
          "properties": {
            "mode": {
              "enum": [
                "scope-grant",
                "production-authorization",
                "direct-confirmation"
              ]
            },
            "bindingHash": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
