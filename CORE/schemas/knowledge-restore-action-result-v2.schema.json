{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/knowledge-restore-action-result@2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "status",
    "providerFree",
    "changed",
    "file",
    "manifestHash",
    "database",
    "assets",
    "scopeAttestationVerified",
    "reportOnlyAssets",
    "repairPerformed"
  ],
  "properties": {
    "schema": { "const": "mkt-videos/knowledge-restore-action-result@2" },
    "action": { "const": "restore" },
    "status": { "enum": ["restored", "restored-asymmetric"] },
    "providerFree": { "const": true },
    "changed": { "const": true },
    "file": { "type": "string", "minLength": 1 },
    "manifestHash": { "$ref": "#/$defs/hash" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userVersion", "bytes", "sha256", "integritySha256"],
      "properties": {
        "userVersion": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "integritySha256": { "$ref": "#/$defs/hash" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "counts"],
      "properties": {
        "mode": {
          "enum": [
            "not-included",
            "legacy-inventory",
            "governed-inventory"
          ]
        },
        "status": {
          "enum": ["not-declared", "match", "asymmetric"]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "resolved",
            "missing",
            "revoked",
            "quarantined",
            "extra",
            "divergent",
            "unsafe"
          ],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "resolved": { "type": "integer", "minimum": 0 },
            "missing": { "type": "integer", "minimum": 0 },
            "revoked": { "type": "integer", "minimum": 0 },
            "quarantined": { "type": "integer", "minimum": 0 },
            "extra": { "type": "integer", "minimum": 0 },
            "divergent": { "type": "integer", "minimum": 0 },
            "unsafe": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "scopeAttestationVerified": { "type": "boolean" },
    "reportOnlyAssets": { "const": true },
    "repairPerformed": { "const": false }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
