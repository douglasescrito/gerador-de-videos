{
  "required": ["transitions", "graphics", "postProduction", "qa", "delivery", "variants"],
  "properties": {
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "edges"],
      "properties": {
        "module": { "const": "ffmpeg-transitions@1" },
        "edges": {
          "type": "array",
          "maxItems": 999,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fromShotId", "toShotId", "transition", "durationFrames"],
            "properties": {
              "fromShotId": { "$ref": "#/$defs/id" },
              "toShotId": { "$ref": "#/$defs/id" },
              "transition": { "enum": ["cut@1", "fade@1", "dissolve@1", "wipe-left@1", "wipe-right@1", "slide-left@1", "slide-right@1"] },
              "durationFrames": { "type": "integer", "minimum": 0, "maximum": 864000 }
            }
          }
        }
      }
    },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "scenes"],
      "properties": {
        "module": { "const": "scene-graphics@1" },
        "scenes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shotId", "renderer", "text", "documentAssetId"],
            "properties": {
              "shotId": { "$ref": "#/$defs/id" },
              "renderer": { "enum": ["none@1", "local-gc@1", "html-canvas@1"] },
              "text": { "type": ["string", "null"], "maxLength": 4000 },
              "documentAssetId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
            }
          }
        }
      }
    },
    "postProduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "operations"],
      "properties": {
        "module": { "const": "ffmpeg-post@1" },
        "operations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "operation", "assetId", "durationFrames"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "operation": { "enum": ["color-normalize@1", "logo-overlay@1", "ending-hold@1"] },
              "assetId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
              "durationFrames": { "type": ["integer", "null"], "minimum": 0, "maximum": 864000 }
            }
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "policy", "technical", "semantic", "assertions"],
      "properties": {
        "module": { "const": "master-qa@1" },
        "policy": { "const": "strict@1" },
        "technical": { "const": true },
        "semantic": { "type": "boolean" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["video-stream", "audio-stream", "duration", "caption-binding", "no-unplanned-frame", "clean-cut"] }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "target", "overwrite", "externalDecision"],
      "properties": {
        "module": { "const": "delivery@1" },
        "target": { "enum": ["local-output@1", "drive-daily@1"] },
        "overwrite": { "const": false },
        "externalDecision": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["confirmation", "bindingHash"],
          "properties": {
            "confirmation": { "const": "confirm-drive-write" },
            "bindingHash": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "items"],
      "properties": {
        "module": { "const": "format-variants@1" },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "strategy", "approved"],
            "properties": {
              "format": { "enum": ["16:9", "9:16", "1:1"] },
              "strategy": { "enum": ["fit-pad", "center-crop"] },
              "approved": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "assetExtensions": {
    "mediaKind": ["document"],
    "role": ["graphics-document", "logo"]
  }
}
