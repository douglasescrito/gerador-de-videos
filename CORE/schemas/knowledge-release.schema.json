{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/knowledge-release@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "rootScopeId",
    "label",
    "previousReleaseId",
    "createdAt",
    "createdBy",
    "members",
    "hash"
  ],
  "properties": {
    "schema": { "const": "mkt-videos/knowledge-release@1" },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$"
    },
    "rootScopeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$"
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 240 },
    "previousReleaseId": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$"
        }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 1, "maxLength": 200 },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "recordType",
          "schemaId",
          "schemaVersion",
          "contentHash"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "revision": { "type": "integer", "minimum": 1 },
          "recordType": { "type": "string", "minLength": 1 },
          "schemaId": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
