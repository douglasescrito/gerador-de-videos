{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/animatic-approval@1",
  "type": "object",
  "required": ["schema", "author", "justification", "approvedAt", "animaticFile", "receiptFile", "fingerprint"],
