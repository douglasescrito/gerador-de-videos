{
  "required": ["executionPolicy", "batch"],
  "properties": {
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "segmentation", "maxClipFrames", "failurePolicy", "partialSuccess", "maxChildren"],
      "properties": {
        "module": { "const": "segmented-execution@1" },
        "segmentation": { "const": "explicit-shots" },
        "maxClipFrames": { "type": "integer", "minimum": 1, "maximum": 864000 },
        "failurePolicy": { "enum": ["fail-fast", "continue"] },
        "partialSuccess": { "enum": ["deny", "allow"] },
        "maxChildren": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "batch": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["module", "rows"],
      "properties": {
        "module": { "const": "explicit-batch@1" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "promptOverrides"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "promptOverrides": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["shotId", "prompt"],
                  "properties": {
                    "shotId": { "$ref": "#/$defs/id" },
                    "prompt": { "type": "string", "minLength": 1, "maxLength": 12000 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

