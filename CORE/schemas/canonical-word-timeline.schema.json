{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/canonical-word-timeline@1",
  "type": "object",
  "required": ["schema", "blockId", "textAuthority", "timestampAuthority", "llmAuthority", "requestFingerprint", "proposalFingerprint", "script", "words", "fingerprint"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "mkt-videos/canonical-word-timeline@1" },
    "blockId": { "type": "string", "minLength": 1 },
    "textAuthority": { "const": "approved-script-only" },
    "timestampAuthority": { "const": "whisper-measured-only" },
    "llmAuthority": { "const": "proposal-only" },
    "requestFingerprint": { "type": "string", "minLength": 16 },
    "proposalFingerprint": { "type": "string", "minLength": 16 },
    "script": { "type": "string", "minLength": 1 },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["word", "start", "end", "measuredTokenIndexes", "transcribed", "lexicalSimilarity"],
        "additionalProperties": false,
        "properties": {
          "word": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "measuredTokenIndexes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
          "transcribed": { "type": "string", "minLength": 1 },
          "lexicalSimilarity": { "type": "number", "minimum": 0, "maximum": 1 },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "fingerprint": { "type": "string", "minLength": 16 }
  }
}
