{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/knowledge-asset-link@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "rootKind",
    "relativePath",
    "expectedSha256",
    "rightsStatus",
    "quarantineStatus"
  ],
  "properties": {
    "schema": {
      "const": "mkt-videos/knowledge-asset-link@1"
    },
    "id": {
      "type": "string",
      "pattern": "^kal_[a-f0-9]{16,64}$"
    },
    "rootKind": {
      "enum": [
        "outputs",
        "PESSOAS",
        "test"
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "expectedSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "rightsStatus": {
      "enum": [
        "allowed",
        "denied",
        "unknown",
        "revoked",
        "expired"
      ]
    },
    "quarantineStatus": {
      "enum": [
        "clear",
        "quarantined"
      ]
    }
  }
}
