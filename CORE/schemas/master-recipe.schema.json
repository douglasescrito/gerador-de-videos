{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/master-recipe@1",
  "title": "Master Audiovisual Recipe V19",
  "description": "Especificação mestre unificada que funde Audio-First (Whisper), Motion Graphics V18, Referências de Imagem/Logo, Ducking, QA e Controles de Montagem.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "mode",
    "aspect",
    "script",
    "scenes",
    "audio",
    "qa",
    "assembly"
  ],
  "properties": {
    "schema": {
      "const": "mkt-videos/master-recipe@1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "audio-first",
        "video-first",
        "motion-graphics-v18",
        "hybrid-studio"
      ],
      "description": "Modo de execução do pipeline: audio-first (narração + whisper primeiro), video-first, motion-graphics-v18 (limpo + ducking) ou hybrid-studio."
    },
    "aspect": {
      "enum": ["16:9", "9:16", "1:1", "4:3"],
      "default": "16:9"
    },
    "targetDurationSeconds": {
      "type": "number",
      "minimum": 5,
      "maximum": 300,
      "default": 60
    },
    "brandSafety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkForbiddenTerms": { "type": "boolean", "default": true },
        "forbiddenTerms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "script": {
      "type": "object",
      "required": ["raw"],
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "string",
          "description": "Texto com tags [ENERGY: ...] e [SFX: ...] para modulação."
        },
        "cleanText": {
          "type": "string",
          "description": "Texto limpo derivado (opcional se processado em tempo de execução)."
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "voice": { "type": "string", "default": "Charon" },
        "readingDirection": { "type": "string" },
        "whisperModel": { "enum": ["tiny", "base", "small", "medium"], "default": "small" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "motionPrompt": { "type": "string" },
          "style": { "type": "string", "default": "react-audiovisual@1" },
          "task": {
            "enum": ["text_to_video", "image_to_video", "reference_to_video", "edit"],
            "default": "text_to_video"
          },
          "referenceImage": { "type": "string", "description": "Caminho da imagem de referência ou logo" },
          "firstFrame": { "type": "string", "description": "Caminho do frame inicial" },
          "durationSeconds": { "type": "number", "minimum": 1, "maximum": 60 },
          "settleOffsetSeconds": { "type": "number", "default": 4.6, "description": "Tempo para o texto do Omni se estabilizar antes do corte" },
          "retryOnFail": { "type": "boolean", "default": false }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": ["music"],
      "additionalProperties": false,
      "properties": {
        "music": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "backend": { "enum": ["flow-music", "auto-energy"], "default": "auto-energy" },
            "prompt": { "type": "string" },
            "bpm": { "type": "integer" },
            "gain": { "type": "number", "default": 0.45 },
            "duckingRatio": { "type": "number", "default": 8 }
          }
        },
        "loudness": { "enum": ["platform", "speech", "broadcast"], "default": "platform" }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "ocrCheck": { "type": "boolean", "default": true },
        "semanticCheck": { "type": "boolean", "default": false },
        "expectedText": { "type": "string" },
        "onFailure": { "enum": ["pause", "retry-scene", "ignore"], "default": "pause" },
        "maxRetries": { "type": "integer", "default": 1 }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "integer", "default": 30 },
        "transition": { "enum": ["cut", "dissolve", "fade-to-black"], "default": "cut" },
        "transitionDuration": { "type": "number", "default": 0.5 },
        "resolution": { "enum": ["720p", "1080p", "4K"], "default": "1080p" },
        "videoFit": { "enum": ["crop", "contain", "loop"], "default": "contain" }
      }
    }
  },
  "additionalProperties": false
}
