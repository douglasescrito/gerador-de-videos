{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/knowledge-asset-link-payload@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rootKind",
    "relativePath",
    "expectedSha256",
    "expectedBytes",
    "mediaType"
  ],
  "properties": {
    "schema": {
      "const": "mkt-videos/knowledge-asset-link-payload@1"
    },
    "rootKind": {
      "enum": ["outputs", "PESSOAS"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "expectedSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
    }
  }
}
