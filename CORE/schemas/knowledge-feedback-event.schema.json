{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/feedback-event@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rootScopeId",
    "scopeId",
    "author",
    "originalText",
    "target",
    "markers",
    "dimensions",
    "verdict",
    "comparison",
    "intendedScope",
    "contextHash",
    "capturedAt"
  ],
  "properties": {
    "schema": {
      "const": "mkt-videos/feedback-event@1"
    },
    "rootScopeId": {
      "$ref": "#/$defs/id"
    },
    "scopeId": {
      "$ref": "#/$defs/id"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "originalText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "markers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeRange",
        "frame",
        "region",
        "track"
      ],
      "properties": {
        "timeRange": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "startMs",
                "endMs"
              ],
              "properties": {
                "startMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "frame": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "region": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "unit": {
                  "const": "normalized"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "track": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "video",
                    "audio",
                    "text",
                    "layer",
                    "mix"
                  ]
                },
                "id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          ]
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "enum": [
          "message",
          "storytelling",
          "hook",
          "clarity",
          "brand",
          "composition",
          "typography",
          "color",
          "camera",
          "motion",
          "timing",
          "rhythm",
          "transition",
          "continuity",
          "performance",
          "voice",
          "music",
          "sfx",
          "mix",
          "legibility",
          "cta",
          "finish",
          "channel-fit"
        ]
      }
    },
    "verdict": {
      "enum": [
        "approved",
        "preferred",
        "change-requested",
        "rejected",
        "observation"
      ]
    },
    "comparison": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alternative",
            "preferred",
            "rationale"
          ],
          "properties": {
            "alternative": {
              "$ref": "#/$defs/alternative"
            },
            "preferred": {
              "enum": [
                "target",
                "alternative",
                "tie"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          }
        }
      ]
    },
    "intendedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "scopeId"
      ],
      "properties": {
        "mode": {
          "enum": [
            "piece",
            "project",
            "client",
            "personal",
            "global-proposal"
          ]
        },
        "scopeId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "contextHash": {
      "$ref": "#/$defs/hash"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "linkRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "revision",
        "contentHash"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionScopeId",
        "artifact",
        "receipt",
        "sceneId",
        "versionId"
      ],
      "properties": {
        "productionScopeId": {
          "$ref": "#/$defs/id"
        },
        "artifact": {
          "$ref": "#/$defs/linkRef"
        },
        "receipt": {
          "$ref": "#/$defs/linkRef"
        },
        "sceneId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "versionId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "receipt",
        "versionId"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/linkRef"
        },
        "receipt": {
          "$ref": "#/$defs/linkRef"
        },
        "versionId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        }
      }
    }
  }
}
