{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/knowledge-relation@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subjectRef",
    "predicate",
    "objectRef",
    "qualifiers",
    "evidenceRefs"
  ],
  "properties": {
    "schema": {
      "const": "mkt-videos/knowledge-relation@1"
    },
    "subjectRef": {
      "$ref": "mkt-videos/knowledge-reference@1"
    },
    "predicate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._/-]{0,199}$"
    },
    "objectRef": {
      "$ref": "mkt-videos/knowledge-reference@1"
    },
    "qualifiers": {
      "type": "object"
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "mkt-videos/knowledge-reference@1"
      }
    }
  }
}
