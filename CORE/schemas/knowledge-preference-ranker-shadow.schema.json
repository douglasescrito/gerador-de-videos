{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/preference-ranker-shadow@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "rankerVersion", "rootScopeId", "decisionId", "asOf",
    "requestFingerprint", "resolutionFingerprint", "status",
    "rankedOptionIds", "selectedOptionId", "viableAlternativeIds",
    "admissibleOptionIds", "blockedOptionIds", "requiresHumanDecision",
    "requiresReplan", "authority", "plannerInfluence", "changed",
    "providerCalls", "fingerprint"
  ],
  "properties": {
    "schema": { "const": "mkt-videos/preference-ranker-shadow@1" },
    "rankerVersion": { "const": "precedence-ranker@1" },
    "rootScopeId": { "$ref": "#/$defs/id" },
    "decisionId": { "$ref": "#/$defs/id" },
    "asOf": { "type": "string", "format": "date-time" },
    "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
    "resolutionFingerprint": { "$ref": "#/$defs/fingerprint" },
    "status": { "enum": ["selected", "no-admissible-option", "blocked-viability", "unresolved-conflict"] },
    "rankedOptionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "selectedOptionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "viableAlternativeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "admissibleOptionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "blockedOptionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "requiresHumanDecision": { "type": "boolean" },
    "requiresReplan": { "type": "boolean" },
    "authority": { "const": "none" },
    "plannerInfluence": { "const": "none" },
    "changed": { "const": false },
    "providerCalls": { "const": 0 },
    "fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
