{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gerador-de-videos/receita@2",
  "title": "Receita Mestre 2.5A - peca visual",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "kind",
    "identity",
    "scope",
    "format",
    "program",
    "videoGeneration",
    "assembly"
  ],
  "properties": {
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": { "policy": { "enum": ["off", "prefer-approved", "require-approved"] } }
    },
    "schema": {
      "const": "gerador-de-videos/receita@2"
    },
    "mode": {
      "const": "studio"
    },
    "kind": {
      "const": "peca"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanReview"
      ],
      "properties": {
        "humanReview": {
          "type": "boolean"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief"],
      "properties": {
        "brief": { "type": "object", "description": "studio-brief@1 selado, revalidado pelo compilador." },
        "creativeDirection": { "type": "object", "description": "Decisão humana creative-direction-decision@1 selada, no mesmo root e projeto." },
        "styleComposition": { "type": "object", "description": "Composição de direção recipe-style-composition@1 congelada com hashes dos prompts, brief e escopo; sem autoridade de execução." },
        "knowledgeContextBinding": { "type": "object", "description": "Binding mínimo knowledge-context-binding@1, sem conteúdo privado; o snapshot materializado é fornecido separadamente ao compilador." }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "request": {
          "description": "Texto literal do pedido humano que originou esta receita. Opcional por compatibilidade; é a evidência de intenção da Fase 9 e não influencia compilação.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootScopeId",
        "projectScopeId"
      ],
      "properties": {
        "rootScopeId": {
          "type": "string",
          "pattern": "^client:[a-z0-9][a-z0-9:_-]*$"
        },
        "projectScopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master"
      ],
      "properties": {
        "master": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "fps"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 16,
              "maximum": 8192
            },
            "height": {
              "type": "integer",
              "minimum": 16,
              "maximum": 8192
            },
            "fps": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "numerator",
                "denominator"
              ],
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120000
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1001
                }
              }
            }
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationPolicy",
        "durationFrames",
        "shots"
      ],
      "properties": {
        "durationPolicy": {
          "const": "fixed-frames"
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640000
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "durationFrames"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 864000
              }
            }
          }
        }
      }
    },
    "videoGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "task",
        "shots"
      ],
      "properties": {
        "module": {
          "const": "omni-video@1"
        },
        "task": {
          "const": "text-to-video"
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shotId",
              "prompt"
            ],
            "properties": {
              "shotId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            }
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "mode",
        "transition"
      ],
      "properties": {
        "module": {
          "const": "ffmpeg-assembly@1"
        },
        "mode": {
          "const": "concat"
        },
        "transition": {
          "const": "cut@1"
        }
      }
    }
  }
}
