{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mkt-videos/knowledge-export-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "status",
    "providerFree",
    "readOnly",
    "storeReadOnly",
    "changed",
    "rootScopeId",
    "releaseId",
    "file",
    "bytes",
    "sha256"
  ],
  "properties": {
    "schema": { "const": "mkt-videos/knowledge-export-result@1" },
    "action": { "const": "export" },
    "status": { "const": "exported" },
    "providerFree": { "const": true },
    "readOnly": { "const": false },
    "storeReadOnly": { "const": true },
    "changed": { "const": true },
    "rootScopeId": { "type": "string", "minLength": 1 },
    "releaseId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "file": { "type": "string", "minLength": 1 },
    "bytes": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
